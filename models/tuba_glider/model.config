<?xml version="1.0"?>
<model>
  <name>TUBA Glider</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>TUBA Sim Project</name>
    <email>sim@tuba.local</email>
  </author>
  <description>
    Open-source underwater glider simulation for gz-sim 10.
    Buoyancy-driven depth control via piston/bladder (BuoyancyEngine).
    Pitch control via sliding battery mass (prismatic joint).
    Zephyr RTOS SIL via UDP bridge.
  </description>
</model>
