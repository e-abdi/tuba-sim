    <!-- Nose ballast: 0.2 kg placed at x=+0.4 m (nose dome section, same region as
         the antenna at +0.36). +X is the nose direction in this model (confirmed by
         antenna at +0.36, rudder at -1.09). The 0.2 kg shifts CoG ~1 cm toward the
         nose to give a slight natural nose-down tendency.
         Mass shifter note: joint axis is +X (toward nose), so POSITIVE joint position
         moves the battery toward the nose → nose-DOWN. NEGATIVE → nose-UP. -->
    <link name="nose_ballast">
      <pose relative_to="__model__">0.4 0 0 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.00005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00005</iyy><iyz>0</iyz>
          <izz>0.00005</izz>
        </inertia>
      </inertial>
      <visual name="nose_ballast_visual">
        <geometry>
          <sphere><radius>0.03</radius></sphere>
        </geometry>
        <material>
          <ambient>0.9 0.4 0.1 1</ambient>
          <diffuse>0.9 0.4 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="fix__nose_ballast" type="fixed">
      <parent>fairing_1</parent>
      <child>nose_ballast</child>
    </joint>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>vbd_1__slider_1</joint_name>
      <topic>/my_glider_v2/vbd_joint_pos</topic>
      <initial_position>0.025</initial_position>
      <p_gain>800</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>80</d_gain>
      <cmd_max>2000</cmd_max>
      <cmd_min>-2000</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>mass_shifter_assembly_1__slider_3</joint_name>
      <topic>/my_glider_v2/battery_joint_pos</topic>
      <initial_position>0.0</initial_position>
      <p_gain>800</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>80</d_gain>
      <cmd_max>2000</cmd_max>
      <cmd_min>-2000</cmd_min>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>vbd_1__slider_1</joint_name>
      <joint_name>mass_shifter_assembly_1__slider_3</joint_name>
    </plugin>
    <plugin filename="gz-sim-buoyancy-engine-system" name="gz::sim::systems::BuoyancyEngine">
      <link_name>buoyancy_engine_link</link_name>
      <namespace>my_glider_v2</namespace>
      <!-- 1 L total range: 0 L (max sink) to 1 L (max float).
           Neutral reference at 0.5 L — engine contributes 0 extra force there.
           Hull alone gives 12.65 kg buoyancy vs 12.67 kg weight → net -0.2 N,
           so at neutral the glider very slowly drifts down (correct hover behaviour).
           At max (1 L): +5.1 N net → rises to surface, antenna sticks out.
           At min (0 L): -5.3 N net → dives quickly. -->
      <min_volume>0.0</min_volume>
      <neutral_volume>0.0005</neutral_volume>
      <default_volume>0.0005</default_volume>
      <max_volume>0.001</max_volume>
      <max_inflation_rate>0.0001</max_inflation_rate>
      <fluid_density>1025.0</fluid_density>
      <!-- surface MUST match the world water surface (z=20), not the seafloor.
           With surface=0.0 (the old value) the engine refused to work because
           the glider at z≈17 was "above" the declared surface. -->
      <surface>20.0</surface>
    </plugin>

    <!-- Hydrodynamics: drag-only on main hull (no added mass — DART engine
         has known instabilities with plugin-based added mass; use drag terms
         only to damp sinking, roll, and pitch oscillations). -->
    <plugin filename="gz-sim-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics">
      <link_name>fairing_1</link_name>
      <!-- Added mass: all zero — use SDF fluid_added_mass instead if needed -->
      <xDotU>0.0</xDotU>
      <yDotV>0.0</yDotV>
      <zDotW>0.0</zDotW>
      <kDotP>0.0</kDotP>
      <mDotQ>0.0</mDotQ>
      <nDotR>0.0</nDotR>
      <!-- Linear drag — yV was -80 which dropped terminal rise speed to ~6 cm/s,
           making the glider look stuck. At -10 the terminal speed is ~19 cm/s
           (3 m to surface in ~16 s) while still damping surface oscillations. -->
      <xU>-0.5</xU><yV>-10.0</yV><zW>-3.0</zW>
      <kP>-1.0</kP><mQ>-3.0</mQ><nR>-3.0</nR>
      <!-- Quadratic drag — high angular terms damp pitch/roll oscillations -->
      <xUabsU>-0.5</xUabsU>
      <yVabsV>-80.0</yVabsV>
      <zWabsW>-80.0</zWabsW>
      <kPabsP>-5.0</kPabsP>
      <mQabsQ>-20.0</mQabsQ>
      <nRabsR>-20.0</nRabsR>
    </plugin>
  </model>
</sdf>